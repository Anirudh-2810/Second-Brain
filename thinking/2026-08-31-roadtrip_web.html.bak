<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roadtrip Focus - Cross-Country Focus Timer</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #051510;
            color: #e0e0e0;
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
        }
        .container {
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
        }
        h1 {
            color: #8ab59a;
            text-align: center;
        }
        .controls {
            text-align: center;
            margin: 20px 0;
        }
        .control-btn {
            background: #0a201a;
            color: #8ab59a;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            margin: 5px;
            border-radius: 4px;
            transition: background 0.3s;
        }
        .control-btn:hover {
            background: #153025;
        }
        .hill-canvas {
            background: linear-gradient(180deg, #051510, #0a201a, #153025);
            height: 400px;
            border-radius: 10px;
            overflow: hidden;
            position: relative;
            margin: 20px auto;
        }
        .pole {
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 20px;
            height: 60px;
            background: #2a2a2a;
            margin-left: -10px;
            border-radius: 0 0 5px 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.5);
        }
        .rock {
            position: absolute;
            bottom: 30px;
            width: 40px;
            height: 40px;
            background: #2a2a2a;
            border: 4px solid #153025;
            border-radius: 50%;
            display: none;
        }
        .info {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
            color: #6aa07a;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Roadtrip Focus</h1>
        
        <div class="controls">
            <button class="control-btn" onclick="startSession()">Start Focus</button>
            <button class="control-btn" onclick="resetSession()">Reset</button>
        </div>
        
        <div class="hill-canvas">
            <!-- Hills will be generated by JS -->
        </div>
        
        <div class="pole" id="pole-left"></div>
        <div class="pole" id="pole-right"></div>
        <div class="rock" id="rock-left"></div>
        <div class="rock" id="rock-right"></div>
        
        <div class="info">
            Session timer with cross-country terrain visualization
        </div>
    </div>

    <script>
        // Session state
        let sessionActive = false;
        let elapsedTime = 0;
        let timerInterval = null;
        let startTime = 0;

        // Hill color definitions - teal-charcoal sequence verified in session
        const hillColorsDark = [
            { color: "#051510",  offset: 0.22,  height: 420, width: 22,  opacity: 0.018, shift: 0 },    // dark teal-green charcoal (far)
            { color: "#0a201a",  offset: 0.45,  height: 360, width: 18,  opacity: 0.024, shift: 1.1 },  // medium teal-charcoal (mid)
            { color: "#153025",  offset: 0.85,  height: 300, width: 14,  opacity: 0.032, shift: 2.4 },  // darkest teal-charcoal (near)
        ];

        const hillColorsLight = [
            { color: "#4a7c59",  offset: 0.22,  height: 420, width: 22,  opacity: 0.018, shift: 0 },    // soft sage green far
            { color: "#6aa07a",  offset: 0.45,  height: 360, width: 18,  opacity: 0.024, shift: 1.1 },  // medium sage green mid
            { color: "#8ab59a",  offset: 0.85,  height: 300, width: 14,  opacity: 0.032, shift: 2.4 },  // light sage green near
        ];

        // Current mode (dark by default for cross-country feel)
        let currentMode = "dark";
        const hillColors = currentMode === "dark" ? hillColorsDark : hillColorsLight;

        // Canvas setup
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        const hillCanvas = document.querySelector('.hill-canvas');
        
        function resizeCanvas() {
            const rect = hillCanvas.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
            ctx.fillStyle = "#051510";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            drawHills();
        }
        
        function drawHills() {
            const hillWidth = canvas.width / hillColors.length;
            
            hillColors.forEach((hill, i) => {
                const startX = i * hillWidth;
                const endX = startX + hillWidth;
                const hillHeight = (canvas.height - 100) * hill.offset;
                const hillActualHeight = hillHeight > 0 ? hillHeight : 1;
                
                ctx.fillStyle = hill.color;
                ctx.globalAlpha = hill.opacity;
                ctx.fillRect(startX, canvas.height - hillActualHeight, hillWidth, hillActualHeight);
                ctx.globalAlpha = 1;
                
                // Add subtle variation based on shift
                ctx.beginPath();
                ctx.moveTo(startX, canvas.height - hillActualHeight);
                ctx.quadraticCurveTo(
                    startX + hillWidth / 2, 
                    canvas.height - hillActualHeight - hill.shift, 
                    endX, 
                    canvas.height - hillActualHeight
                );
                ctx.closePath();
                
                // Draw with subtle texture
                ctx.fillStyle = hill.color;
                ctx.globalAlpha = Math.min(hill.opacity * 0.5, 0.1);
                ctx.fill();
                ctx.globalAlpha = 1;
            });
        }

        // Pole and rock elements
        const poleLeft = document.getElementById('pole-left');
        const poleRight = document.getElementById('pole-right');
        const rockLeft = document.getElementById('rock-left');
        const rockRight = document.getElementById('rock-right');

        function updatePolePosition() {
            const canvasWidth = canvas.width;
            const poleWidth = 20;
            poleLeft.style.left = `${canvasWidth / 4 - poleWidth / 2}px`;
            poleRight.style.left = `${3 * canvasWidth / 4 - poleWidth / 2}px`;
            
            rockLeft.style.left = `${canvasWidth / 4 - 20 / 2}px`;
            rockRight.style.left = `${3 * canvasWidth / 4 - 20 / 2}px`;
        }

        // Initialize
        resizeCanvas();
        window.addEventListener('resize', () => {
            resizeCanvas();
            drawHills();
            updatePolePosition();
        });

        // Session controls
        function startSession() {
            if (sessionActive) return;
            sessionActive = true;
            startTime = Date.now() - elapsedTime;
            timerInterval = setInterval(updateTimer, 1000);
            updatePolePosition();
        }

        function resetSession() {
            sessionActive = false;
            clearInterval(timerInterval);
            elapsedTime = 0;
            document.getElementById('timer').textContent = '0m';
            updatePolePosition();
        }

        function updateTimer() {
            elapsedTime += 1000;
            const mins = Math.floor(elapsedTime / 60000);
            document.getElementById('timer').textContent = `${mins}m`;
        }
    </script>
    
    <!-- Session stats (as of today) -->
    <!-- stats: {"total_min": 31, "total_sessions": 7, "total_completed": 7, "streak": 1, "last_date": "2026-08-30"} -->
</body>